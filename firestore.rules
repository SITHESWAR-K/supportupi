rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public support pages
    match /pages/{pageId} {
      // Anyone can view a support page by its slug
      allow read: if true;

      // Only authenticated users can create a page, and ownerUid must match
      allow create: if request.auth != null 
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.slug is string
                    && request.resource.data.upiId is string
                    && request.resource.data.title is string;

      // Only the owner can update or delete their page
      allow update, delete: if request.auth != null 
                            && resource.data.ownerUid == request.auth.uid;
    }

    // User profiles (optional metadata cache)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
